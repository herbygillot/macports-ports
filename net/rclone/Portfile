# Portfile for rclone

PortSystem 1.0
PortGroup github 1.0

github.setup rclone rclone 1.71.0

# rclone is a command line program to manage files on cloud storage.
# See https://rclone.org/

homepage https://rclone.org/
master_sites https://github.com/rclone/rclone/releases/download/v${version}/

checksums rmd160 9a7d57f4b4de4f6e0d8b6b8c94a4f8f4c7e4e7f7 \
    sha256 09cbd4b5e02b3c84b5a85e4af8c2a3b9b3270f4e8a0d8e0563e7c6c6b7a14c5d

depends_lib-append port:go

use_configure no

build.env GOPATH=${prefix}/go

# rclone needs to be built with go
build.cmd go build -o rclone

livecheck.type github
livecheck.url https://github.com/rclone/rclone/releases
livecheck.regex v([0-9]+\.[0-9]+\.[0-9]+)